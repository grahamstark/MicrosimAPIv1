[Unit]
Description=Runs Microsimulation models by checking a database queue.
After=network.target remote-fs.target nss-lookup.target

[Service]
# Type=forking
User=apiuser
EnvironmentFile=/home/apiuser/julia/vw/MicrosimAPIv1/etc/environment
# The PID file is optional, but recommended in the manpage
# "so that systemd can identify the main process of the daemon"
PIDFile=/run/RunnerListener.pid
WorkingDirectory=/home/apiuser/julia/vw/MicrosimAPIv1/
ExecStart=/home/apiuser/.juliaup/bin/julia --project=. --startup-file=no -t auto /home/apiuser/julia/vw/MicrosimAPIv1/bin/runner-listener.jl
ExecStop=/bin/kill -WINCH ${MAINPID}
KillSignal=SIGKILL
PrivateTmp=true
TimeoutStartSec=360
Restart=on-failure
[Install]
WantedBy=multi-user.target
