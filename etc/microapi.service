[Unit]
Description=MicrosimAPI Server in Julia
After=network.target remote-fs.target nss-lookup.target

[Service]
# Type=forking
User=apiuser
EnvironmentFile=/etc/systemd/user/gks_environment
# The PID file is optional, but recommended in the manpage
# "so that systemd can identify the main process of the daemon"
PIDFile=/run/MicrosimAPI.pid
WorkingDirectory=/opt/api/package/MicrosimAPIv1/
ExecStart=/opt/api/julia/bin/julia --project=. --startup-file=no -t auto /opt/api/package/MicrosimAPIv1/bin/oxyserver.jl
ExecStop=/bin/kill -WINCH ${MAINPID}
KillSignal=SIGKILL
PrivateTmp=true
TimeoutStartSec=360
Restart=on-failure
[Install]
WantedBy=multi-user.target
