[Unit]
Description=MicrosimAPI Server in Julia, Oxygen version.
After=network.target remote-fs.target nss-lookup.target
[Service]
# Type=forking
User=apiuser
EnvironmentFile=/home/apiuser/julia/vw/MicrosimAPIv1/etc/environment
# The PID file is optional, but recommended in the manpage
# "so that systemd can identify the main process of the daemon"
PIDFile=/run/MicrosimAPI.pid
WorkingDirectory=/home/apiuser/julia/vw/MicrosimAPIv1/
ExecStart=/home/apiuser/.juliaup/bin/julia --project=. --startup-file=no -t auto /home/apiuser/julia/vw/MicrosimAPIv1/bin/oxyserver.jl
ExecStop=/bin/kill -WINCH ${MAINPID}
KillSignal=SIGKILL
PrivateTmp=true
TimeoutStartSec=360
Restart=on-failure
[Install]
WantedBy=multi-user.target
After=network-online.target remote-fs.target nss-lookup.target
Wants=network-online.target
